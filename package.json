{
  "name": "starbish-browser",
  "version": "1.0.0",
  "description": "Starbish Browser - Privacy-first web browser combining Mullvad zero-telemetry & amnesic security with Brave speed and ad-blocking.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux deb AppImage --publish never"
  },
  "keywords": [
    "browser",
    "privacy",
    "chromium",
    "adblocker",
    "mullvad",
    "brave",
    "starbish"
  ],
  "author": {
    "name": "drylexx3",
    "email": "drylexx3@users.noreply.github.com"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.4.45",
    "cross-fetch": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.starbish.browser",
    "productName": "Starbish Browser",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "maintainer": "Starbish Team <drylexx3@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser;",
      "icon": "assets/icon.png"
    }
  }
}
